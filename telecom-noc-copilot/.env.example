# Application
APP_ENV=development
APP_NAME=telecom-noc-copilot
LOG_LEVEL=INFO

# Frontend (Vite loads this file from the telecom-noc-copilot directory)
VITE_API_BASE_URL=http://localhost:8000
VITE_APP_TITLE=Telecom NOC Copilot
# Labeled demo-data fallback when an API is unavailable.
# Dashboard uses GET /api/v1/dashboard/summary; Site Health uses GET /sites and
# GET /sites/{site_id}/metrics; Alarms uses GET /alarms; Incident Investigation
# uses GET /incidents, GET /incidents/{incident_id},
# POST /incidents/{incident_id}/investigate,
# POST /incidents/{incident_id}/approve, and GET /incidents/{incident_id}/report.
# Approvals also use GET /approvals.
# Runbook Guidance uses GET /runbooks/search and
# GET /incidents/{incident_id}/runbooks.
# Vite development also allows the fallback.
VITE_USE_DEMO_DATA=false

# Backend / FastAPI
BACKEND_HOST=0.0.0.0
BACKEND_PORT=8000
CORS_ORIGINS=http://localhost:5173

# PostgreSQL — local Docker (see docker-compose.yml)
# Copy this file to .env and replace placeholders. Never commit .env.
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=telecom_noc
POSTGRES_USER=noc_user
POSTGRES_PASSWORD=local_dev_password

# Set DATABASE_DISABLED=true to force JSON fixtures (used by default pytest).
# DATABASE_DISABLED=false

# SQLAlchemy URL. When unset, mock OSS APIs keep using synthetic JSON files.
# Local:
DATABASE_URL=postgresql+psycopg://noc_user:Welcome1@localhost:5432/telecom_noc
# Isolated pytest database (optional). Never point this at shared/production RDS.
# TEST_DATABASE_URL=postgresql+psycopg://noc_user:local_dev_password@localhost:5432/telecom_noc_test

# TLS for AWS RDS. Local Docker does not need verify-full.
# verify-ca / verify-full require DATABASE_SSL_ROOT_CERT (do not disable verification).
DATABASE_SSL_MODE=prefer
DATABASE_SSL_ROOT_CERT=

# Optional: load username/password/host/port/dbname from Secrets Manager in deployed
# environments instead of embedding credentials in DATABASE_URL. Requires boto3.
DATABASE_SECRET_ARN=
AWS_REGION=us-east-1

# Amazon Bedrock / AgentCore (placeholders — set via secrets in CI/CD)
BEDROCK_MODEL_ID=
BEDROCK_KNOWLEDGE_BASE_ID=
AGENTCORE_RUNTIME_ARN=
AGENTCORE_GATEWAY_URL=

# RAG / S3
S3_BUCKET_NAME=
S3_RAG_PREFIX=rag/

# MCP
MCP_SERVER_URL=http://localhost:8080

# Mock services
OSS_API_URL=http://localhost:9001
TELEMETRY_API_URL=http://localhost:9002
DEPLOYMENT_API_URL=http://localhost:9003
TICKETING_API_URL=http://localhost:9004
